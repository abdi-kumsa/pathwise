# ── Database ───────────────────────────────────────────────
DB_USER=pathwise_user
DB_PASSWORD=pathwise_pass
DB_NAME=pathwise_db
DB_HOST=db
# In-container port. Do NOT change — this is what the backend dials.
DB_PORT=5432

# Full connection URL (constructed from the above in docker-compose)
DATABASE_URL=postgresql://pathwise_user:pathwise_pass@db:5432/pathwise_db

# ── Backend API ────────────────────────────────────────────
API_HOST=0.0.0.0
# In-container port uvicorn binds to. Do NOT change.
API_PORT=8000

# Leave empty for a stable server. Set to --reload only while actively editing
# backend code — uvicorn's watcher crash-loops on Windows bind mounts.
BACKEND_RELOAD=

# ── Auth ───────────────────────────────────────────────────
# dev (default) or production. Outside dev the backend refuses to start with a
# missing, empty, default or short (< 32 byte) JWT_SECRET, and will not seed
# demo accounts with the published demo password.
ENV=dev

# Signing key for JWTs. Required (32+ bytes) whenever ENV is not dev. In dev an
# unset value falls back to a built-in key with a startup warning. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# Password given to the five seeded demo accounts (admin, student, moe, mol,
# university) on first start. DEMO ONLY — rotate this and re-seed before
# exposing the deployment to anyone.
DEMO_PASSWORD=pathwise123

# ── Leftover US models (waiver WV.US1) ────────────────────
# Placement / salary XGBoost, LSTM enrolment and Prophet demand. Off by default:
# the API then never imports TensorFlow or Prophet and their routes and pages
# do not exist. Set both to bring them back for a side-by-side demonstration.
LEGACY_US_MODELS=0
VITE_LEGACY_US_MODELS=false

# ── Rate limiting ─────────────────────────────────────────
# In-process limits on sign-in, sign-up, password change, page-view, reports and
# scenario runs. Set RATE_LIMIT_SCALE=10 for a load test, RATE_LIMIT_ENABLED=0
# to switch off. TRUST_PROXY=1 only behind a proxy that appends the client IP
# to X-Forwarded-For (Render does); otherwise clients could spoof their IP.
RATE_LIMIT_ENABLED=1
RATE_LIMIT_SCALE=1
TRUST_PROXY=0

# ── Host ports ─────────────────────────────────────────────
# HOST side of each docker-compose port mapping. Change these — not the
# in-container ports above — when another project already owns a port.
# Check first with:  netstat -ano | grep LISTENING | grep ':5434 '
DB_HOST_PORT=5434
API_HOST_PORT=8000
FRONTEND_HOST_PORT=3001

# ── Frontend ───────────────────────────────────────────────
# Must match FRONTEND_HOST_PORT — this is the CORS origin the browser sends.
FRONTEND_URL=http://localhost:3001
# Must match API_HOST_PORT — the browser, not the container, resolves this.
VITE_API_URL=http://localhost:8000
