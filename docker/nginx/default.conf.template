# PathWise frontend — static SPA with security headers.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # React Router: every unknown path serves the app shell.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hashed build assets can be cached forever; the shell must not be.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/conf.d/security-headers.inc;
    }
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/conf.d/security-headers.inc;
    }

    include /etc/nginx/conf.d/security-headers.inc;
}
