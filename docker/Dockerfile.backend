FROM python:3.11-slim

WORKDIR /app

# ── System dependencies ────────────────────────────────────────────────────────
# gcc / g++    : compile Python extensions (psycopg2-binary, some numpy deps)
# libpq-dev    : PostgreSQL client headers for psycopg2
# libgomp1     : GNU OpenMP — required by XGBoost for parallel tree building
# libhdf5-dev  : HDF5 — required by TensorFlow when loading .keras model files
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    libgomp1 \
    libhdf5-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# ── Python dependencies ────────────────────────────────────────────────────────
# Copy requirements first so Docker caches this layer.
# Packages only re-install when a requirements file changes, not on every
# source code change.
COPY requirements.txt requirements-legacy.txt ./
# Generous timeout and retries: a slow mirror should slow the build, not fail it.
ENV PIP_DEFAULT_TIMEOUT=120 PIP_RETRIES=10
RUN pip install --no-cache-dir -r requirements.txt

# Leftover US models (TensorFlow, Prophet, XGBoost, SHAP) only on request:
#   docker compose build --build-arg LEGACY_US_MODELS=1 backend
# and run with LEGACY_US_MODELS=1 so their routes are registered.
ARG LEGACY_US_MODELS=0
RUN if [ "$LEGACY_US_MODELS" = "1" ]; then         pip install --no-cache-dir -r requirements-legacy.txt;     fi

# ── TensorFlow / environment tunables ─────────────────────────────────────────
# Suppress TF startup banner and oneDNN info messages in container logs
ENV TF_CPP_MIN_LOG_LEVEL=3
ENV TF_ENABLE_ONEDNN_OPTS=0

# ── Application source ────────────────────────────────────────────────────────
COPY . .

# Run as an unprivileged user (plan item 3.4). The app writes only to the
# model-output and monitoring folders, which in docker-compose are bind mounts.
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin app     && chown -R app:app /app
USER app

EXPOSE 8000

# No --reload: uvicorn's file watcher crash-loops on Windows bind mounts
# ("WatchfilesRustInternalError: IO error for operation on /app"), which leaves
# the API reachable but with zero models loaded. docker-compose overrides this
# command and appends --reload when BACKEND_RELOAD is set in .env.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
